<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FeladatEllenorzo_CP"
             xmlns:pages="clr-namespace:FeladatEllenorzo_CP.Pages"
             x:Class="FeladatEllenorzo_CP.MainPage"
             SafeAreaEdges="All"
             BackgroundColor="{DynamicResource PageBackgroundColor}">
    <!-- .NET 10: a ContentPage alapból edge-to-edge (SafeAreaEdges=None), Androidon ezért
         a WebView a navigációs sáv alá rajzolt. Az "All" a rendszersávokat és a billentyűzetet is kikerüli. -->

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type local:Main}" />
                </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
