@using Microsoft.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components
@inherits FluentDialogInstance
  <FluentDialogBody>
     <FluentStack VerticalAlignment="VerticalAlignment.Center">
        <FluentLabel Typo="Typography.PaneHeader">
   @DialogInstance.Options.Header
        </FluentLabel>
     </FluentStack>
     <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
        <FluentNumberInput Label="int"
                           Width="100px"
                           Message="@($"Value: {Content.PontSzam}")"
                           MessageCondition="@(e => true)"
                           @bind-Value="@Content.PontSzam" />
        <FluentTextInput @bind-Value="@Content.Jegyzet" Style="width: 100%;">Jegyzet:</FluentTextInput>
    </FluentStack>
      <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@SaveAsync">Mentés</FluentButton>
      <FluentButton Appearance="ButtonAppearance.Default" OnClick="@CancelAsync">Mégse</FluentButton>
  </FluentDialogBody>

@code {
    [Parameter]
    public Pont Content { get; set; } = default!;

    private async Task SaveAsync()
    {
         await DialogInstance.CloseAsync(Content);
    }
    private async Task CancelAsync()
    {
         await DialogInstance.CancelAsync();
    }

    protected override Task OnActionClickedAsync(bool primary)
    {
        if (primary)
        {
            return SaveAsync();
        }
        else
        {
            return CancelAsync();
        }
    }
}