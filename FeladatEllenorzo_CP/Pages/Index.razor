@page "/"
@using Microsoft.FluentUI.AspNetCore.Components.Extensions
@using Microsoft.Graph.Models
@using System.Text;
@using System.Text.Json;
@using System.ComponentModel;
@using System.Windows.Input;
@using System.Diagnostics
@inject IGraphService _graphService
@inject NavigationManager navi
@inject INavigationService _navigationService
@inject IAuthenticationService auth
@inject ISettingsService settingsService
@inject IAlertService alert
@inject ISzovegService szoveg
@inject ICsoportService csoportService
@inject IThemeService ThemeService

<PageHeader Title="FeladatEllenőrző" Subtitle="@(Me is null ? null : $"Bejelentkezve: {Me.DisplayName}")" ShowBack="false">
    <Actions>
        <FluentButton Appearance="ButtonAppearance.Subtle"
                      IconOnly="true"
                      Title="Világos / sötét téma"
                      OnClick="@(async e => await ThemeService.SwitchThemeAsync())">
            <FluentIcon Class="hidden-if-light" Value="@(new Icons.Regular.Size20.WeatherSunny())" />
            <FluentIcon Class="hidden-if-dark" Value="@(new Icons.Regular.Size20.WeatherMoon())" />
        </FluentButton>
        @if (Me is not null)
        {
            <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size20.SignOut())" OnClick="OnSignInOrOut">Kijelentkezés</FluentButton>
        }
    </Actions>
</PageHeader>

@if (Me is null)
{
    <div class="fe-card" style="max-width:420px">
        <h2 class="fe-card__title">Bejelentkezés</h2>
        <p>A feladatok ellenőrzéséhez jelentkezzen be a Microsoft 365 fiókjával.</p>
        <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size20.PersonArrowRight())" OnClick="OnSignInOrOut">Bejelentkezés</FluentButton>
    </div>
}
else if (classes is null)
{
    <p class="fe-muted">Osztályok betöltése...</p>
}
else
{
    <div class="fe-split fe-split--half">
        <div class="fe-card">
            <h2 class="fe-card__title">1. Osztály kiválasztása</h2>
            <FluentSelect Label="Tantárgy" TOption="string" TValue="string"
                          Width="100%" Placeholder="Válasszon tantárgyat"
                          @onchange="e => SelectedSubject(e.Value)">
                <FluentOptionString Value="">Összes tantárgy</FluentOptionString>
                <FluentOptionString Value="matematika" Selected="true">Matematika</FluentOptionString>
                <FluentOptionString Value="fizika">Fizika</FluentOptionString>
                <FluentOptionString Value="digit">Digitális kultúra</FluentOptionString>
            </FluentSelect>
            <div style="margin-top:12px">
                <FluentListbox TOption="EducationClass" TValue="string" Items="_classes" OptionValue="c => c.Id" OptionText="c => c.DisplayName" @bind-Value="SelectedClassId" Width="100%" />
            </div>
        </div>

        <div class="fe-card">
            <h2 class="fe-card__title">2. Művelet</h2>
            <p class="fe-muted" style="margin-top:0">
                @(string.IsNullOrEmpty(SelectedClassId) ? "Az osztályhoz kötött műveletekhez előbb válasszon osztályt." : $"Kiválasztva: {_classes?.FirstOrDefault(c => c.Id == SelectedClassId)?.DisplayName}")
            </p>
            <div class="fe-stack">
                <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size20.TaskListSquareLtr())" OnClick="Feladat_btn" Disabled="@(string.IsNullOrEmpty(SelectedClassId))">Feladatok ellenőrzése</FluentButton>
                <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size20.Trophy())" OnClick="Pont_btn" Disabled="@(string.IsNullOrEmpty(SelectedClassId))">Pontok</FluentButton>
            </div>
            <h2 class="fe-card__title" style="margin-top:16px">Összesítők</h2>
            <div class="fe-stack">
                <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size20.DocumentDismiss())" OnClick="Hiany_btn">Hiányzó feladatok</FluentButton>
                <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size20.DocumentError())" OnClick="Hiba_btn">Hibás feladatok</FluentButton>
                @if (data.Szovegek.Count > 0)
                {
                    <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size20.TextBulletListSquareEdit())" OnClick="ManageSzovegOpen">Szövegsablonok</FluentButton>
                }
            </div>
            <h2 class="fe-card__title" style="margin-top:16px">Karbantartás</h2>
            <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size20.ArrowSync())" OnClick="ManageTanulok" Title="Új tanulók átvétele a Teams osztályból (ritkán szükséges)">Tanulók szinkronizálása</FluentButton>
        </div>
    </div>
}

<footer class="fe-footer">
    <span>FeladatEllenőrző</span>
    <span id="version">verzió 1.5.1</span>
    <FluentTooltip Anchor="version">2026.11.18</FluentTooltip>
</footer>
@code{
    private EducationClassCollectionResponse classes;
    private List<EducationClass> _classes;
    private User Me = null;
    private string SelectedClassId = string.Empty;
    string path = Path.Combine(FileSystem.Current.AppDataDirectory, "szoveg.json");
    public ICommand SignInOrOutCommand { get; private set; }
    // public DesignThemeModes Mode { get; set; }
    // public OfficeColor? OfficeColor { get; set; }

    public bool IsSignedIn
    {
        get => auth?.IsSignedIn ?? false;
    }
    protected override async Task OnInitializedAsync()
    {
        NetworkAccess accessType = Connectivity.Current.NetworkAccess;
        if (accessType != NetworkAccess.Internet)
        {
            await alert.ShowAlertAsync("Nincs internet, állítsa helyre a kapcsolatot!", "Internet hiba", "Rendben");
            return;
        }
        if (!IsSignedIn)
        {
            SignInOrOutCommand = new Command(
        execute: async () => await OnSignInOrOut());
            await OnSignInOrOut();
            _graphService.InitializeGraphForAppOnlyAuth(settingsService);
            data.Szovegek = await szoveg.GetSzovegek();
            if (File.Exists(path) && data.Szovegek.Count == 0)
            {
                await ReadSzoveg();
            }
            else if (data.Szovegek.Count == 0)
            {
                // Create the file.
                var text = await InitSzoveg();
                using (StreamWriter sw = new StreamWriter(path))
                {
                    sw.WriteLine(text);
                }
                //await ReadSzoveg();
            }
        }
        await GetUserDetailsAsync();
        auth.PropertyChanged += OnPropertyChanged;
    }
    private async Task<string> InitSzoveg()
    {
        data.Szovegek = new List<DataSzoveg>()
    {
                new DataSzoveg(){ Type = "poz", Text = "tökéletes 👍" },
                new DataSzoveg(){ Type = "poz", Text = "nagyon jó"},
                new DataSzoveg(){ Type = "poz", Text = "rendben ✔️."},
                new DataSzoveg(){ Type = "poz", Text = "rendben hibátlan 🥇"},
                new DataSzoveg(){ Type = "poz", Text = "rendben majdnem hibátlan 🥈"},
                new DataSzoveg(){ Type = "neg", Text = "hiányos feladat"},
                new DataSzoveg(){ Type = "neg", Text = "feladat rész hiányzik"},
                new DataSzoveg(){ Type = "neg", Text = "miért nincs feltöltve a kép a házi feladatodról⁉️"}
        };
        foreach (var item in data.Szovegek)
        {
            var response = await szoveg.Add(item);
            if (response.IsSuccess)
            {
                await notificationService.ShowInfoToastAsync("Rendszer üzenet", response.Content.ToString(), 5000);
                //await alert.ShowAlertAsync(response.Content.ToString(),"Rendszer üzenet","Rendben");
            }
            else
            {
                await alert.ShowAlertAsync(response.ErrorMessage, "Rendszer üzenet", "Rendben");
            }
        }
        return JsonSerializer.Serialize(data.Szovegek);
    }
    private async Task ReadSzoveg()
    {
        try
        {
            data.Szovegek.Clear();
            using (StreamReader sr = File.OpenText(path))
            {
                string s = "";
                s = await sr.ReadToEndAsync();
                data.Szovegek = JsonSerializer.Deserialize<List<DataSzoveg>>(s);
            }
            foreach (var item in data.Szovegek)
            {
                var response = await szoveg.Add(item);
                if (response.IsSuccess)
                {
                    //toastService.ShowInfo("Az üzenet mentve a szövegek közé.");
                    await notificationService.ShowInfoToastAsync("Rendszer üzenet", "Az üzenet mentve a szövegek közé.", 5000);
                    //await alert.ShowAlertAsync(response.Content.ToString(),"Rendszer üzenet","Rendben");
                }
                else
                {
                    await alert.ShowAlertAsync(response.ErrorMessage, "Rendszer üzenet", "Rendben");
                }
            }
        }
        catch (Exception e)
        {
            await alert.ShowAlertAsync($"Hiba: {e.Message}", "Szöveg beolvasási hiba", "Rendben");
        }
    }
    private void SelectedClass(object value)
    {
        if (value is not null)
        {
            SelectedClassId = value.ToString();
            data.Osztalynev = classes.Value.Find(c => c.Id == SelectedClassId).DisplayName;
        }
    }
    private void SelectedSubject(object value)
    {
        if (value is not null && value.ToString() != "")
        {
            var subject = value.ToString().ToLower();
            _classes = classes.Value.Where(c => c.DisplayName.ToLower().Contains(subject) && !c.DisplayName.Contains("Exp")).ToList();
        }
        else
        {
            _classes = classes.Value.Where(c => !c.DisplayName.Contains("Exp")).ToList();
        }
    }
    private void Feladat_btn()
    {
        // A Feladatok oldal fejléce az osztály nevét mutatja.
        data.Class = classes?.Value?.Find(c => c.Id == SelectedClassId) ?? data.Class;
        navi.NavigateTo($"feladatok/{SelectedClassId}");
    }
    private void Hiany_btn()
    {
        navi.NavigateTo("hiany");
    }
    private void Hiba_btn()
    {
        navi.NavigateTo("hiba");
    }
    private async Task Pont_btn()
    {
        if (string.IsNullOrEmpty(SelectedClassId))
        {
            await notificationService.ShowErrorToastAsync("Rendszer üzenet", "Kérem válasszon ki egy osztályt a pontok megtekintéséhez.", 5000);
            return;
        }
        data.Class = classes.Value.Find(c => c.Id == SelectedClassId);
        navi.NavigateTo($"pontok/{SelectedClassId}");
    }
    /// <summary>
    /// Event handler for property change event on authentication service's IsSignedIn property
    /// </summary>
    private async void OnPropertyChanged(object sender, PropertyChangedEventArgs args)
    {
        //var v = nameof(auth.IsSignedIn);
        if (args.PropertyName == nameof(auth.IsSignedIn))
        {
            // Bubble up the change to any views bound to this view model
            //OnPropertyChanged(nameof(IsSignedIn));
            await HandleSignInChangeAsync();
        }
    }

    private async Task HandleSignInChangeAsync()
    {
        // Update the button text
        SignInOrOutText = IsSignedIn ? "Kijelentkezés" : "Bejelentkezés";

        if (IsSignedIn)
        {
            await GetUserDetailsAsync();
        }
        else
        {
            UserName = string.Empty;
            UserEmail = string.Empty;
        }
    }
    private string _signInOrOutText = "Bejelentkezés";
    /// <summary>
    /// The text to display on the sign in/out button
    /// </summary>
    public string SignInOrOutText
    {
        get => _signInOrOutText;
        set => _signInOrOutText = value;
    }

    private string _userName;
    /// <summary>
    /// The user's display name
    /// </summary>
    public string UserName
    {
        get => _userName;
        set => _userName = value;
    }

    private string _userEmail;
    /// <summary>
    /// The user's email address
    /// </summary>
    public string UserEmail
    {
        get => _userEmail;
        set => _userEmail = value;
    }

    private async Task OnSignInOrOut()
    {
        try
        {
            Debug.WriteLine("=== OnSignInOrOut meghívva ===");
            Debug.WriteLine($"IsSignedIn: {IsSignedIn}");
            
            if (IsSignedIn)
            {
                Debug.WriteLine("Kijelentkezés kezdése...");
                await auth.SignOutAsync();
                Debug.WriteLine("Kijelentkezés sikeres");
            }
            else
            {
                Debug.WriteLine("Bejelentkezés kezdése...");
                var success = await auth.SignInAsync();
                Debug.WriteLine($"Bejelentkezés eredménye: {success}");
            }
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"HIBA az OnSignInOrOut-ban: {ex.GetType().Name}: {ex.Message}");
            Debug.WriteLine($"Stack trace: {ex.StackTrace}");
            await alert.ShowAlertAsync($"Bejelentkezési hiba: {ex.Message}", "Hiba", "Rendben");
        }
    }

    protected async Task HandleSignInChange()
    {
        // Update the button text
        SignInOrOutText = IsSignedIn ? "Kijelentkezés" : "Bejelentkezés";

        if (IsSignedIn)
        {
            await GetUserDetailsAsync();
        }
        else
        {
            UserName = string.Empty;
            UserEmail = string.Empty;
        }
    }

    /// <summary>
    /// Get the user's info and photo from Microsoft Graph
    /// </summary>
    private async Task GetUserDetailsAsync()
    {
        try
        {
            NetworkAccess accessType = Connectivity.Current.NetworkAccess;
            if (accessType != NetworkAccess.Internet)
            {
                await alert.ShowAlertAsync("Nincs internet, állítsa helyre a kapcsolatot!", "Internet hiba", "Rendben");
                return;
            }

            // Timeout beállítása 30 másodpercre az Azure API hívásokhoz
            using (var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30)))
            {
                // Get user
                Me = await _graphService.GetUserInfoAsync();
                data.UserId = Me.Id;

                classes = await _graphService.GetTaughtClasses(Me.Id);
                var csoportok = await csoportService.GetCsoportok();

                foreach (var item in classes.Value)
                {
                    var csoport = csoportok.FirstOrDefault(c => c.Id == Guid.Parse(item.Id));
                    if (csoport is null)
                    {
                        await csoportService.CreateCsoport(new Csoport { Id = Guid.Parse(item.Id), Name = item.DisplayName });
                    }
                    else if (csoport.Name != item.DisplayName)
                    {
                        csoport.Name = item.DisplayName;
                        await csoportService.UpdateCsoport(csoport.Id, csoport);
                    }
                }
                _classes = classes.Value.Where(c => c.DisplayName.ToLower().Contains("matematika") && !c.DisplayName.Contains("Exp")).ToList();
                InitializeTanuloData tanuloData = new(data, _graphService);
                await tanuloData.SetupTanuloData(_classes);
            }
        }
        catch (OperationCanceledException)
        {
            await alert.ShowAlertAsync("Az adatok betöltése időtúllépés miatt meg lett szakítva. Kérjük próbálja újra!", "Timeout", "Rendben");
        }
        catch (Exception ex)
        {
            await alert.ShowAlertAsync($"Hiba az adatok betöltésekor: {ex.Message}", "Hiba", "Rendben");
        }
        finally
        {
            StateHasChanged();
        }
    }
    void ManageSzovegOpen()
    {
        navi.NavigateTo("szoveg/");
    }
    private async Task ManageTanulok()
    {
        if (string.IsNullOrEmpty(SelectedClassId))
        {
            await notificationService.ShowErrorToastAsync("Rendszer üzenet", "Kérem válasszon ki egy osztályt a tanulók szinkronizálásához.", 5000);
            return;
        }
        data.Class = classes.Value.Find(c => c.Id == SelectedClassId);

        InitializeTanuloData tanuloData = new(data, _graphService);
        await tanuloData.NewTanulok(data.Class);
    }
}
