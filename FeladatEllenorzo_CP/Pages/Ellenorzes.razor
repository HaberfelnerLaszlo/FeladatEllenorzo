@page "/ell"
@using FeladatEllenorzo_CP.Services;
@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@using FeladatLibrary.Data
@inject IGraphService graph
@inject GlobalData data
@inject NavigationManager navi
@inject IAlertService alert
@inject INotificationService notificationService
@inject IDialogService dialogService
@inject IHibaService hibaService
@inject IHianyService hianyService
@inject ISzorgalmiService szorgalmiService
@inject IPontService pontService

<PageHeader Title="@(string.IsNullOrEmpty(data.Name) ? "Ellenőrzés" : data.Name)" Subtitle="@AssignmentName" OnBack="Back">
    <Actions>
        @if (AktualisTag is not null)
        {
            <span class="status @StatusClass(AktualisTag.Status)">@AktualisTag.Status</span>
        }
        @if (data.Members.Count > 0)
        {
            <select class="fe-select fe-select--auto" aria-label="Tanuló kiválasztása" @onchange="(e) => SelectedMember(e.Value)">
                @foreach (var csoport in TanuloCsoportok)
                {
                    @if (csoport.Tagok.Count > 0)
                    {
                        <optgroup label="@csoport.Nev">
                            @foreach (var item in csoport.Tagok)
                            {
                                <option value="@item.SubmissionId" selected="@(item.SubmissionId == data.SubmissionId)">@item.Name</option>
                            }
                        </optgroup>
                    }
                }
            </select>
            <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size20.ChevronLeft())" Title="Előző tanuló" OnClick="Previous">Előző</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Outline" IconEnd="@(new Icons.Regular.Size20.ChevronRight())" Title="Következő tanuló" OnClick="Next">Következő</FluentButton>
        }
        <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size20.DocumentText())" Title="A feladat kiírása" OnClick="ViewAssigment">Feladat</FluentButton>
    </Actions>
</PageHeader>

<div class="fe-split">
    @* ---------- Bal oldal: csatolmányok és előnézet ---------- *@
    <section>
        <div class="fe-row fe-row--spread">
            <div class="chip-list">
                @foreach (var csatolmany in Csatolmanyok)
                {
                    <button type="button"
                            class="chip @(csatolmany.FileUrl == aktivFileUrl ? "chip--active" : "")"
                            title="@csatolmany.Nev"
                            @onclick="() => ShowImage(csatolmany.FileUrl)">
                        @csatolmany.Nev
                    </button>
                }
            </div>
            @if (!string.IsNullOrEmpty(url))
            {
                <FluentButton Appearance="ButtonAppearance.Subtle"
                              IconStart="@(showPreview ? new Icons.Regular.Size20.EyeOff() : new Icons.Regular.Size20.Eye())"
                              OnClick="@(() => showPreview = !showPreview)">
                    @(showPreview ? "Előnézet elrejtése" : "Előnézet mutatása")
                </FluentButton>
            }
        </div>
        @if (!string.IsNullOrEmpty(DisplayMessage))
        {
            <p class="fe-warning">@DisplayMessage</p>
        }
        @if (string.IsNullOrEmpty(url))
        {
            <div class="preview-empty">Nincs beküldött csatolmány.</div>
        }
        else if (showPreview)
        {
            <iframe class="preview-frame" src="@url" title="Csatolmány előnézete"></iframe>
        }
    </section>

    @* ---------- Jobb oldal: visszajelzés, pontozás, könyvelés ---------- *@
    <aside class="fe-card fe-has-fixed-bar">
        <h2 class="fe-card__title">Visszajelzés</h2>
        <textarea class="fe-textarea"
                  placeholder="Visszajelzés..."
                  oninput="this.style.height = 'auto'; this.style.height = (this.scrollHeight) + 'px';"
                  @onchange=@((e) => Valtozas(false, e))
                  value="@Valasz"
                  lang="hu"
                  spellcheck="false"></textarea>
        @if (data.Szovegek.Count > 0)
        {
            <div class="chip-list" aria-label="Szövegsablonok">
                @foreach (var item in data.Szovegek.Where(s => s.Type == "poz"))
                {
                    <button type="button" class="chip chip--poz" title="@item.Text" @onclick="() => AddText(item.Text)">@item.Text</button>
                }
                @foreach (var item in data.Szovegek.Where(s => s.Type == "neg"))
                {
                    <button type="button" class="chip chip--neg" title="@item.Text" @onclick="() => AddText(item.Text)">@item.Text</button>
                }
            </div>
        }
        <div class="fe-row">
            <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size20.ArrowReset())" OnClick="@(() => { Valasz = "Kedves " + nev; })">Új válasz</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size20.Add())" OnClick="AddNewText">Új sablon</FluentButton>
            @if (data.Szovegek.Count > 0)
            {
                <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size20.TextBulletListSquareEdit())" OnClick="ManageSzovegOpen">Sablonok</FluentButton>
            }
        </div>
        <div hidden="@visibleNewText">
            <FeladatEllenorzo_CP.Components.NewSzoveg SaveText="SaveText"></FeladatEllenorzo_CP.Components.NewSzoveg>
        </div>

        <h2 class="fe-card__title" style="margin-top:16px">Pontozás</h2>
        <div class="fe-row">
            <input id="pont" type="number" class="fe-input fe-input--narrow" value="@Pont" @onchange=@((e) => Valtozas(true, e)) />
            <label for="pont">pont</label>
            @if (FeladatHelper.MaxPont(AktualisFeladat) is float max)
            {
                <span class="fe-muted" title="A Teams-feladatnál beállított maximális pontszám">max. @max</span>
            }
            @if (!IsNotSaved)
            {
                <span class="fe-saved" title="A Teamsben már szerepel pontszám">✔ Mentve</span>
            }
        </div>

        <h2 class="fe-card__title" style="margin-top:16px">Könyvelés</h2>
        <div class="fe-switch-group">
            <span class="fe-switch-group__label">Hiba / hiány</span>
            <FluentSwitch Label="Hibaként menteni" Value="isHiba" @onclick="(() => ChangeHiba())" />
            <FluentSwitch Label="Hiányként menteni" Value="isHiany" @onclick="(() => ChangeHiany())" />
            <span class="fe-switch-group__label">Szorgalmi</span>
            <FluentSwitch Label="Szorgalmi" Value="isSzorg" @onclick="(() => ChangeSzorgalmi())" />
            <FluentSwitch Label="Szorgalmi és lecke" Value="isSzorgLecke" @onclick="(() => ChangeSzorgalmiLecke())" />
            <span class="fe-switch-group__label">Egyéb</span>
            <FluentSwitch Label="Pótlás" Value="isPotlas" @onclick="(() => isPotlas = !isPotlas)" />
            <FluentSwitch Label="Nincs mentés az adatbázisba" Value="noSave" @onclick="(() => noSave = !noSave)" />
        </div>

        <div class="fe-action-bar fe-action-bar--fixed-mobile">
            <FluentButton Appearance="ButtonAppearance.Primary"
                          IconStart="@(new Icons.Regular.Size20.Send())"
                          Disabled="@(!changed || isSaving)"
                          OnClick="Save">
                @(isSaving ? "Mentés..." : "Mentés és visszaküldés")
            </FluentButton>
            @if (!changed)
            {
                <span class="fe-muted">Nincs mentetlen változás</span>
            }
        </div>
    </aside>
</div>
@code {
    private EducationSubmissionResourceCollectionResponse feladatForrasok;
    private List<EducationMediaResource> mediaResource = new();
    private List<EducationFileResource> fileResource = new();
    private List<EducationExcelResource> excelResource = new();
    private List<EducationWordResource> wordResource = new();
    private List<EducationPowerPointResource> ppResource = new();
    private EducationOutcomeCollectionResponse feladatValaszok;
    private EducationFeedbackOutcome valasz;
    private EducationPointsOutcome pont;
    private Szorgalmi szorgalmi;
    private string DriveId = string.Empty, ItemId = string.Empty, url = string.Empty, Valasz = string.Empty, nev = string.Empty, DisplayMessage = string.Empty, AssignmentName = string.Empty;
    private bool changed = false, changedValasz = false, changedPont = false, IsNotSaved = true, visibleNewText = true, isHiba = false, isHiany = false, isSzorg = false, isPotlas = false, isSzorgLecke = false, noSave = false, isSaving = false;
    private int index = 0, i = 0;
    private float Pont = 0;
    private string aktivFileUrl = string.Empty;
    private bool showPreview = true;
   // private IDialogReference _dialog;

    private MemberData AktualisTag => data.Members.FirstOrDefault(m => m.SubmissionId == data.SubmissionId);

    private EducationAssignment AktualisFeladat => data.Feladatok.Find(f => f.Feladat.Id == data.AssignmentId)?.Feladat;

    private static string StatusClass(string statusz) => StatuszHelper.StatusClass(statusz);

    /// <summary>A tanulóválasztó csoportjai: előbb a beadottak, aztán a visszaküldöttek, végül a többiek.</summary>
    private IEnumerable<(string Nev, List<MemberData> Tagok)> TanuloCsoportok =>
    [
        ("Beadta", data.Members.Where(m => m.Status == StatuszHelper.Beadva).ToList()),
        ("Visszaküldve", data.Members.Where(m => m.Status == StatuszHelper.Visszakuldve).ToList()),
        ("Többiek", data.Members.Where(m => m.Status != StatuszHelper.Beadva && m.Status != StatuszHelper.Visszakuldve).ToList()),
    ];

    /// <summary>Az összes megnyitható csatolmány egy listában (név + fájl URL).</summary>
    private IEnumerable<(string Nev, string FileUrl)> Csatolmanyok =>
        mediaResource.Select(r => (r.DisplayName, r.FileUrl))
            .Concat(fileResource.Select(r => (r.DisplayName, r.FileUrl)))
            .Concat(excelResource.Select(r => (r.DisplayName, r.FileUrl)))
            .Concat(wordResource.Select(r => (r.DisplayName, r.FileUrl)))
            .Concat(ppResource.Select(r => (r.DisplayName, r.FileUrl)))
            .Where(c => !string.IsNullOrEmpty(c.FileUrl))
            .Select(c => (c.DisplayName ?? "Csatolmány", c.FileUrl));
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            nev = NevHelper.KeresztNev(data.Name);
            isHiany = data.IsHiany > 0;
            AssignmentName = data.Feladatok.Find(f => f.Feladat.Id == data.AssignmentId)?.Feladat.DisplayName ?? string.Empty;
            await DataInit();
        }
        await base.OnAfterRenderAsync(firstRender);
    }
    private async Task DataInit()
    {
        NetworkAccess accessType = Connectivity.Current.NetworkAccess;
        if (accessType != NetworkAccess.Internet)
        {
            await alert.ShowAlertAsync("Nincs internet, állítsa helyre a kapcsolatot!", "Internet hiba", "Rendben");
            return;
        }
        changed = false;
        changedPont = false;
        changedValasz = false;
        IsNotSaved = true;
        mediaResource.Clear();
        fileResource.Clear();
        wordResource.Clear();
        excelResource.Clear();
        ppResource.Clear();
        url = string.Empty;
        Pont = 0;
        // Az előző tanuló outcome-jait nem szabad továbbvinni.
        valasz = null;
        pont = null;
        Valasz = "Kedves " + nev;
        try
        {
            string elsoFileUrl = null;
            feladatForrasok = await graph.GetFeladatForras(data.ClassId, data.AssignmentId, data.SubmissionId);
            foreach (var item in feladatForrasok?.Value ?? [])
            {
                string fileUrl = null;
                switch (item.Resource)
                {
                    case EducationMediaResource r:
                        mediaResource.Add(r);
                        fileUrl = r.FileUrl;
                        break;
                    case EducationFileResource r:
                        fileResource.Add(r);
                        fileUrl = r.FileUrl;
                        break;
                    case EducationExcelResource r:
                        excelResource.Add(r);
                        fileUrl = r.FileUrl;
                        break;
                    case EducationWordResource r:
                        wordResource.Add(r);
                        fileUrl = r.FileUrl;
                        break;
                    case EducationPowerPointResource r:
                        ppResource.Add(r);
                        fileUrl = r.FileUrl;
                        break;
                    default:
                        break;
                }
                if (!string.IsNullOrEmpty(fileUrl))
                {
                    elsoFileUrl ??= fileUrl;
                }
            }
            aktivFileUrl = elsoFileUrl ?? string.Empty;
            if (elsoFileUrl is not null)
            {
                url = await GetUrl(elsoFileUrl);
            }
            feladatValaszok = await graph.GetFeladatValasz(data.ClassId, data.AssignmentId, data.SubmissionId);
            foreach (var item in feladatValaszok?.Value ?? [])
            {
                if (item is EducationFeedbackOutcome v)
                {
                    valasz = v;
                    if (!string.IsNullOrEmpty(v.Feedback?.Text?.Content))
                    {
                        Valasz = v.Feedback.Text.Content;
                    }
                }
            }
            var feladatPontok = await graph.GetFeladatPont(data.ClassId, data.AssignmentId, data.SubmissionId);
            foreach (var item in feladatPontok?.Value ?? [])
            {
                if (item is EducationPointsOutcome p)
                {
                    pont = p;
                    if (p.Points?.Points is float meglevoPont)
                    {
                        Pont = meglevoPont;
                        IsNotSaved = false;
                    }
                }
            }
            // Csak akkor javasolunk új pontot (a Teams-feladat maximuma, ennek hiányában 2), ha van csatolmány
            // és még nincs (vagy 0) a pontszám. Már értékelt beadásnál a changedPont hamis marad,
            // így újramentéskor nem kerül be újra a lecke pont.
            if (elsoFileUrl is not null && Pont == 0)
            {
                Pont = FeladatHelper.AlapPont(AktualisFeladat);
                changedPont = true;
            }
        }
        catch (Exception e)
        {
            await alert.ShowAlertAsync(e.Message, "Kivétel történt", "Ok");
        }
        StateHasChanged();
    }
    private async Task Next()
    {
        if (data.Members.Count == 0) return;
        var j = data.Members.FindIndex(m => m.SubmissionId == data.SubmissionId);
        var kovetkezo = (j >= 0 && j < data.Members.Count - 1) ? data.Members[j + 1] : data.Members[0];
        data.SubmissionId = kovetkezo.SubmissionId;
        data.Name = kovetkezo.Name;
        nev = NevHelper.KeresztNev(kovetkezo.Name);
        data.StudentId = kovetkezo.Id;
        isHiany = kovetkezo.IsHiany > 0;
        data.IsHiany = kovetkezo.IsHiany;
        await DataInit();
    }
    private async Task<string> GetUrl(string fileUrl)
    {
        NetworkAccess accessType = Connectivity.Current.NetworkAccess;
        if (accessType != NetworkAccess.Internet)
        {
            await alert.ShowAlertAsync("Nincs internet, állítsa helyre a kapcsolatot!", "Internet hiba", "Rendben");
            return string.Empty;
        }
        // A fix pozíciós Substring helyett a .../drives/{driveId}/items/{itemId} részt keressük meg.
        var match = System.Text.RegularExpressions.Regex.Match(fileUrl ?? string.Empty, @"drives/([^/]+)/items/([^/?#]+)");
        if (match.Success)
        {
            try
            {
                DriveId = match.Groups[1].Value;
                ItemId = match.Groups[2].Value;
                var fileInfo = await graph.GetFile(DriveId, ItemId);
                if (fileInfo is not null)
                {
                    if (DisplayMessage.Length > 0)
                    {
                        DisplayMessage = string.Empty;
                    }
                    return fileInfo.GetUrl;
                }
            }
            catch (System.Net.Http.HttpRequestException)
            {
                DisplayMessage = "Sajnos hálozati hiba történt!";
            }
            catch (Exception ex)
            {
                DisplayMessage = $"Valami hiba történt a fájl lekérésekor: {ex.Message}";
            }
        }
        return string.Empty;
    }
    private async Task Previous()
    {
        if (data.Members.Count == 0) return;
        var j = data.Members.FindIndex(m => m.SubmissionId == data.SubmissionId);
        var elozo = j > 0 ? data.Members[j - 1] : data.Members[^1];
        data.SubmissionId = elozo.SubmissionId;
        data.Name = elozo.Name;
        nev = NevHelper.KeresztNev(elozo.Name);
        data.StudentId = elozo.Id;
        isHiany = elozo.IsHiany > 0;
        data.IsHiany = elozo.IsHiany;
        await DataInit();
    }
    private async Task ShowImage(string fileUrl)
    {
        aktivFileUrl = fileUrl;
        showPreview = true;
        url = await GetUrl(fileUrl);
        StateHasChanged();
    }
    private async Task SelectedMember(object args)
    {
        var tanulo = data.Members.FirstOrDefault(m => m.SubmissionId == args?.ToString());
        if (tanulo is null) return;
        data.SubmissionId = tanulo.SubmissionId;
        nev = NevHelper.KeresztNev(tanulo.Name);
        data.Name = tanulo.Name;
        data.StudentId = tanulo.Id;
        isHiany = tanulo.IsHiany > 0;
        data.IsHiany = tanulo.IsHiany;
        await DataInit();
    }
    private void Valtozas(bool changePont, ChangeEventArgs args)
    {
        changed = true;
        IsNotSaved = true;
        if (changePont)
        {
            // A number input mindig ponttal küldi a tizedest, ezért kultúrafüggetlenül olvassuk.
            if (!float.TryParse(args.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var ujPont))
            {
                return;
            }
            changedPont = true;
            Pont = ujPont;
        }
        else
        {
            changedValasz = true;
            Valasz = args.Value.ToString();
        }
    }
    private void Back()
    {
        navi.NavigateTo($"feladatok/{data.ClassId}");
    }
    private async Task Save()
    {
        // Dupla kattintás / párhuzamos mentés ellen: különben a pontok kétszer kerülnének be.
        if (isSaving) return;
        isSaving = true;
        try
        {
            await SaveCore();
        }
        catch (Exception ex)
        {
            await alert.ShowAlertAsync(ex.Message, "Hiba a mentéskor", "Rendben");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }
    private async Task SaveCore()
    {
        NetworkAccess accessType = Connectivity.Current.NetworkAccess;
        if (accessType != NetworkAccess.Internet)
        {
            await alert.ShowAlertAsync("Nincs internet, állítsa helyre a kapcsolatot!", "Internet hiba", "Rendben");
            return;
        }
        var response = false;
        if (valasz is not null && changedValasz)
        {
            response = await graph.UpdateValasz(data.ClassId, data.AssignmentId, data.SubmissionId, valasz.Id, Valasz);
        }
        if (pont is not null && changedPont)
        {
            response = await graph.UpdatePont(data.ClassId, data.AssignmentId, data.SubmissionId, pont.Id, Pont);
            if (isPotlas)
            {
                var res = await pontService.Add(new() { Datum = DateTime.Today, PontSzam = 1, TanuloId = data.StudentId, Jegyzet = data.AssignmentId, PontTipus = PontTipus.Pótlás });
                isPotlas = false;
                if (res.IsSuccess)
                {
                    //toastService.ShowInfo("A pótlás mentve az adatbázisba.");
                    await notificationService.ShowInfoToastAsync("A pótlás mentve az adatbázisba.");
                }
                else if (res.ErrorMessage is not null)
                {
                    await alert.ShowAlertAsync(res.ErrorMessage.Normalize(), "Rendszer üzenet", "Rendben");
                }
                else
                {
                    await alert.ShowAlertAsync("A válasz hiba üzenete null érték lett!", "Hiba üzenet", "Rendben");
                }
            }
            else if (!isSzorg && !noSave)
            {
                var res = await pontService.Add(new() { Datum = DateTime.Today, PontSzam = (int)Pont, TanuloId = data.StudentId, Jegyzet = $"{AssignmentName} ; {data.AssignmentId}", PontTipus = PontTipus.Lecke });
                if (res.IsSuccess)
                {
                    //toastService.ShowInfo("A pont mentve az adatbázisba.");
                    await notificationService.ShowInfoToastAsync("Üzenet","A pont mentve az adatbázisba.",5);
                    //await alert.ShowAlertAsync(res.Content.ToString(), "Rendszer üzenet", "Rendben");
                }
                else
                {
                    await alert.ShowAlertAsync(res.ErrorMessage, "Rendszer üzenet", "Rendben");
                }
            }
        }
        if (isHiba)
        {
            var res = await hibaService.Add(new() { Datum = DateOnly.FromDateTime(DateTime.Today), Leiras = Valasz, TanuloId = data.StudentId, Osztaly = data.Osztalynev });
            isHiba = false;
            if (res.IsSuccess)
            {
                await notificationService.ShowInfoToastAsync("Az üzenet mentve a hibákhoz.");
            }
            else
            {
                await alert.ShowAlertAsync(res.ErrorMessage, "Rendszer üzenet", "Rendben");
            }
        }
        // Csak akkor rögzítünk új hiányt, ha még nincs; különben minden mentés újabb -2 pontot vonna le.
        if (isHiany && data.IsHiany == 0)
        {
            var res = await hianyService.Add(new() { Datum = DateTime.Today, Hianyzik = false, TanuloId = data.StudentId, FeladatId = Guid.Parse(data.AssignmentId), Osztaly = data.Osztalynev });
            isHiany = false;
            if (res.IsSuccess)
            {
                await notificationService.ShowInfoToastAsync("A tanuló feladata mentve a lecke hiányhoz.");
            }
            else
            {
                await alert.ShowAlertAsync(res.ErrorMessage, "Rendszer üzenet", "Rendben");
            }
        }
        else if (!isHiany)
        {
            if (data.IsHiany > 0)
            {
                var res = await hianyService.Remove(data.IsHiany);
                if (res.IsSuccess)
                {
                    await notificationService.ShowInfoToastAsync("A tanuló lecke hiánya eltávolítva.");
                    var tag = data.Members.FirstOrDefault(m => m.SubmissionId == data.SubmissionId);
                    if (tag is not null) tag.IsHiany = 0;
                    data.IsHiany = 0;
                }
                else
                {
                    await alert.ShowAlertAsync(res.ErrorMessage, "Rendszer üzenet", "Rendben");
                }
            }
        }
        if ((isSzorg || isSzorgLecke) && szorgalmi is not null)
        {
            var res = await szorgalmiService.Add(szorgalmi);
            if (res.IsSuccess)
            {
                await notificationService.ShowInfoToastAsync("A szorgalmi mentve az adatbázisba.");
                isSzorg = false;
                isSzorgLecke = false;
            }
            else
            {
                Console.Write("Hiba a szorgalmi mentésekor: " + res.ErrorMessage);
                isSzorg = false;
                isSzorgLecke = false;
                await notificationService.ShowErrorToastAsync($"Hiba a szorgalmi mentésekor! Üzenet: {res.ErrorMessage}");
            }
        }
        if (!response)
        {
            await notificationService.ShowErrorToastAsync("A mentés nem sikerült!");
        }
        else
        {
            var returned = await graph.Return(data.ClassId, data.AssignmentId, data.SubmissionId);
            if (returned)
            {
                var tag = data.Members.FirstOrDefault(m => m.SubmissionId == data.SubmissionId);
                if (tag is not null) tag.Status = "Visszaküldve";
            }
            await Next();
        }
    }
    private void AddText(string text)
    {
        Valasz = Valasz + $" {text}";
        changed = true;
        changedValasz = true;
    }
    void AddNewText()
    {
        visibleNewText = false;
    }
    void SaveText()
    {
        visibleNewText = true;
    }
    void ManageSzovegOpen()
    {
        navi.NavigateTo("szoveg/ell");
    }
    void ChangeHiba()
    {
        isHiba = isHiba ? false : true;
    }
    void ChangeHiany()
    {
        isHiany = isHiany ? false : true;
    }
    async Task ChangeSzorgalmi()
    {
        isSzorg = !isSzorg;
        if (!isSzorg)
        {
            // Kikapcsoláskor nem kell újra megnyitni a dialógust.
            if (!isSzorgLecke) szorgalmi = null;
            return;
        }
        szorgalmi = new() { Feladatok_szama = 1, Pont = 2, Osztaly = data.ClassId, TanuloId = data.StudentId ,Jegyzet = string.Empty};

        //dialog
        DialogResult result=await dialogService.ShowDialogAsync<DialogAddSzorgalmi>(options =>
        {
            options.Alignment = DialogAlignment.Default;
            options.Header.Title = "Szorgalmi felvétele";
            options.Parameters.Add(nameof(DialogAddSzorgalmi.Content), szorgalmi);
            options.Footer.PrimaryAction.Label = "Mentés";
            options.Footer.PrimaryAction.Disabled = false;
            options.Footer.SecondaryAction.Label = "Mégsem";
            options.Footer.SecondaryAction.Disabled = false;
        });
        if (!result.Cancelled)
        {
            // A kötés miatt a helyben módosított objektum is helyes, ha a Value mégis üres lenne.
            szorgalmi = result.Value as Szorgalmi ?? szorgalmi;
        }
        else { isSzorg = false; szorgalmi = null; }

    }
    async Task ChangeSzorgalmiLecke()
    {
        isSzorgLecke = !isSzorgLecke;
        if (!isSzorgLecke)
        {
            if (!isSzorg) szorgalmi = null;
            return;
        }
        szorgalmi = new() { Feladatok_szama = 1, Pont = 2, Osztaly = data.ClassId, TanuloId = data.StudentId, Jegyzet = $"{AssignmentName} ; {data.AssignmentId}" };
        DialogResult result = await dialogService.ShowDialogAsync<DialogAddSzorgalmi>(options =>
        {
            options.Alignment = DialogAlignment.Default;
            options.Header.Title = "Szorgalmi felvétele";
            options.Parameters.Add(nameof(DialogAddSzorgalmi.Content),szorgalmi);
            options.Footer.PrimaryAction.Label = "Mentés";
            options.Footer.PrimaryAction.Disabled = false;
            options.Footer.SecondaryAction.Label = "Mégsem";
            options.Footer.SecondaryAction.Disabled = false;

        });
        if (!result.Cancelled)
        {
            szorgalmi = result.Value as Szorgalmi ?? szorgalmi;
        }
        else { isSzorgLecke = false; szorgalmi = null; }

    }

    async Task ViewAssigment()
    {
        var message = data.Feladatok.Find(f => f.Feladat.Id == data.AssignmentId)?.Feladat.Instructions?.Content ?? "Nincs feladatleírás.";
        var dialog = await dialogService.ShowMessageBoxAsync(new MessageBoxOptions()
            {
                Title = "Feladat kiírása",
                Message = message,
                Icon = new Icons.Regular.Size24.Textbox(),
                IconColor = Color.Success,
                PrimaryButton = "Bezár", 
            });
    }
