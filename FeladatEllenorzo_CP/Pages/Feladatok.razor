@page "/feladatok/{id}"
@inject IGraphService graph
@inject NavigationManager navi
@inject IAlertService alert
@inject IHianyService hiany
@inject ITanuloService tanuloService

<PageHeader Title="Feladatok" Subtitle="@data.Class?.DisplayName" OnBack="Back">
    <Actions>
        @if (submissions is not null)
        {
            <span class="fe-muted">Kijelölés:</span>
            <FluentButton Appearance="ButtonAppearance.Outline" Title="A megtekintett, de be nem adott feladatok kijelölése" OnClick="@(() => Select("Working"))" Disabled="@disableWorking">Megtekintették</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Outline" Title="A beadott feladatok kijelölése" OnClick="@(() => Select("Submitted"))" Disabled="@disableSubmitted">Beadták</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@(() => Select("None"))" Disabled="@disableNone">Nem tekintették meg</FluentButton>
        }
    </Actions>
</PageHeader>

<div class="fe-split fe-split--list @(i > 0 ? "fe-has-fixed-bar" : "")">
    @* ---------- Bal oszlop: feladatlista, vagy kijelöléskor a tömeges visszajelzés ---------- *@
    <section>
        @if (i <= 0)
        {
            <h2 class="fe-card__title">Kiadott feladatok</h2>
            @if (data.Feladatok.Count == 0)
            {
                <p class="fe-muted">@(feladatok is null ? "Feladatok betöltése..." : "Még nincs feladat.")</p>
            }
            else
            {
                <ul class="fe-list">
                    @foreach (var item in data.Feladatok)
                    {
                        <li class="fe-list__item @(data.AssignmentId == item.Feladat.Id ? "fe-list__item--selected" : "")"
                            @onclick="@(() => SelectedFeladat(item.Feladat.Id))">
                            <span class="fe-list__main truncate" title="@item.Feladat.DisplayName">@item.Feladat.DisplayName</span>
                            <span class="fe-list__meta">
                                <span class="count-badge count-badge--beadva" title="Beadva: @item.SubmittedCount">@item.SubmittedCount</span>
                                @if (item.WorkingCount > 0)
                                {
                                    <span class="count-badge count-badge--folyamatban" title="Folyamatban (megtekintve, nincs beadva): @item.WorkingCount">@item.WorkingCount</span>
                                }
                            </span>
                        </li>
                    }
                </ul>
            }
        }
        else
        {
            <div class="fe-card">
                <h2 class="fe-card__title">Tömeges visszajelzés – @i tanuló kijelölve</h2>
                <FluentSwitch Value="isHiany" Label="Hiányként menteni" @onclick="(() => ChangeHiany())" />
                <label class="fe-label" for="datumHiany" style="margin-top:8px">Könyvelés dátuma</label>
                <input id="datumHiany" type="date" class="fe-input fe-select--auto" @bind="datumHiany" @bind:format="yyyy-MM-dd" />

                <label class="fe-label" for="valaszTomeges" style="margin-top:8px">Visszajelzés</label>
                <textarea id="valaszTomeges"
                          class="fe-textarea"
                          placeholder="Visszajelzés..."
                          oninput="this.style.height = 'auto'; this.style.height = (this.scrollHeight) + 'px';"
                          @onchange=@((e) => Valtozas(false, e))
                          value="@Valasz"
                          lang="hu"
                          spellcheck="false"></textarea>
                @if (data.Szovegek.Count > 0)
                {
                    <div class="chip-list" aria-label="Szövegsablonok">
                        @foreach (var item in data.Szovegek.Where(s => s.Type == "poz"))
                        {
                            <button type="button" class="chip chip--poz" title="@item.Text" @onclick="() => AddText(item.Text)">@item.Text</button>
                        }
                        @foreach (var item in data.Szovegek.Where(s => s.Type == "neg"))
                        {
                            <button type="button" class="chip chip--neg" title="@item.Text" @onclick="() => AddText(item.Text)">@item.Text</button>
                        }
                    </div>
                }
                <div class="fe-row">
                    <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size20.Add())" OnClick="AddNewText">Új sablon</FluentButton>
                    @if (data.Szovegek.Count > 0)
                    {
                        <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size20.TextBulletListSquareEdit())" OnClick="ManageSzovegOpen">Sablonok</FluentButton>
                    }
                </div>
                <div hidden="@visibleNewText">
                    <FeladatEllenorzo_CP.Components.NewSzoveg SaveText="SaveText"></FeladatEllenorzo_CP.Components.NewSzoveg>
                </div>

                <div class="fe-row" style="margin-top:8px">
                    <input id="pontTomeges" type="number" class="fe-input fe-input--narrow" value="@Pont" @onchange=@((e) => Valtozas(true, e)) />
                    <label for="pontTomeges">pont</label>
                    @if (!IsNotSaved)
                    {
                        <span class="fe-saved">✔ Mentve</span>
                    }
                </div>

                <div class="fe-action-bar fe-action-bar--fixed-mobile">
                    <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size20.Send())" Disabled="@(!changed)" OnClick="Save">Mentés és visszaküldés</FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Outline" Title="A kijelölt tanulók felmentése a feladat alól" OnClick="Exused">Felmentve</FluentButton>
                </div>
            </div>
        }
    </section>

    @* ---------- Jobb oszlop: tanulók a kiválasztott feladathoz ---------- *@
    <section>
        @if (submissions is not null)
        {
            <div class="fe-row fe-row--spread">
                <h2 class="fe-card__title" style="margin:0">Tanulók (@data.Members.Count)</h2>
                <div class="fe-legend">
                    <span class="status status-beadva">Beadva</span>
                    <span class="status status-visszakuldve">Visszaküldve</span>
                    <span class="status status-megtekintve">Megtekintve</span>
                    <span class="status status-egyeb">Nincs</span>
                </div>
            </div>
            <ul class="fe-list">
                @foreach (var item in data.Members)
                {
                    <li class="fe-list__item @(item.Selected ? "fe-list__item--selected" : "")"
                        title="Megnyitás ellenőrzésre"
                        @onclick="() => SelectedFeladatEll(item)">
                        <input type="checkbox"
                               aria-label="@($"{item.Name} kijelölése")"
                               checked="@item.Selected"
                               @onclick="() => ItemSelectChange(item)"
                               @onclick:stopPropagation="true" />
                        <span class="fe-list__main truncate">@item.Name</span>
                        <span class="fe-list__meta">
                            @if (item.ResourceCount > 0)
                            {
                                <span class="count-badge" title="Csatolmányok száma: @item.ResourceCount">📎 @item.ResourceCount</span>
                            }
                            <span class="status @StatuszHelper.StatusClass(item.Status)">@item.Status</span>
                        </span>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="fe-muted">Válasszon feladatot a bal oldali listából.</p>
        }
    </section>
</div>
@code {
    [Parameter] public string Id { get; set; } //ClassId
    private EducationAssignmentCollectionResponse feladatok;
    private EducationUserCollectionResponse tagok;
    private EducationSubmissionCollectionResponse submissions;
    private EducationOutcomeCollectionResponse feladatValaszok;
    private EducationFeedbackOutcome valasz;
    private EducationPointsOutcome pont;
    private List<MemberData> SelectedMembers = new(), saveError = new();
    private int i = 0; //kijelölt tanulók száma
    private bool changed = false,  IsNotSaved = true, disableWorking = false, disableSubmitted = false, disableNone = false, isError = false, isHiany = false, visibleNewText = true;
    private float Pont = 0;
    private string Valasz = string.Empty;
    // Helyi dátum: a UtcNow éjfél körül az előző napra könyvelt volna.
    DateTime datumHiany = DateTime.Today;
    protected override async Task OnParametersSetAsync()
    {
        NetworkAccess accessType = Connectivity.Current.NetworkAccess;
        if (accessType != NetworkAccess.Internet)
        {
            await alert.ShowAlertAsync("Nincs internet, állítsa helyre a kapcsolatot!", "Internet hiba", "Rendben");
            return;
        }
        data.ClassId = Id;
        if (data.Feladatok.Count == 0)
        {
            feladatok = await graph.GetFeladatok(Id);
            var feladat = feladatok.Value.FirstOrDefault(f => f.AssignedDateTime < DateTime.UtcNow);
            if (feladat is null) { await notificationService.ShowInfoToastAsync("Nincs feladat kiadva."); return; }
            data.AssignmentId = feladat.Id; //feladatok.Value[0].Id;
            var utasitas = feladat.Instructions?.Content ?? string.Empty;
            var maxpoints = feladat.Grading;
            await GetCount();
        }
        else _ = UpdateCount(data.AssignmentId);
        if (data.Members.Count == 0)
        {
            tagok = await graph.GetMembers(Id); //Csoport tagok
            foreach (var item in tagok.Value.OrderBy(t => t.DisplayName))
            {
                if (item.PrimaryRole != EducationUserRole.Teacher)
                {
                    data.Members.Add(new() { Id = Guid.Parse(item.Id), Name = item.DisplayName });
                    //var resp = await tanuloService.CreateTanulo(new() { Id = Guid.Parse(item.Id), Name = item.DisplayName, Osztaly=data.Osztalynev});
                    //if (!resp.IsSuccess)
                    //{
                    //    await alert.ShowAlertAsync("Hiba történt a tanuló mentésekor!", "Mentési hiba", "Rendben");
                    //}
                    //TODO: Később a tanulók adatait is le kell kérni a feladatokhoz
                }
            }
        }
        SelectedFeladat(data.AssignmentId);
    }
    private async Task GetCount()
    {
        NetworkAccess accessType = Connectivity.Current.NetworkAccess;
        if (accessType != NetworkAccess.Internet)
        {
            await alert.ShowAlertAsync("Nincs internet, állítsa helyre a kapcsolatot!", "Internet hiba", "Rendben");
            return;
        }
        foreach (var item in feladatok.Value)
        {
            var i = await graph.GetSubmittedFeladat(Id, item.Id);
            //SubmittedCount.Add(item.Id, (int)i.OdataCount);
            var j = await graph.GetWorkingFeladat(Id, item.Id);
            //WorkingCount.Add(item.Id, (int)j.OdataCount);
            if ((int)i.OdataCount > 0 || (int)j.OdataCount > 0)
            {
                data.Feladatok.Add(new() { Feladat = item, SubmittedCount = (int)i.OdataCount, WorkingCount = (int)j.OdataCount });
            }
        }
    }
    private async Task UpdateCount(string feladatId)
    {
        var feladat = data.Feladatok.FirstOrDefault(f => f.Feladat.Id == feladatId);
        if (feladat is null) return;
        var i = await graph.GetSubmittedFeladat(Id, feladat.Feladat.Id);
        var j = await graph.GetWorkingFeladat(Id, feladat.Feladat.Id);
        feladat.SubmittedCount = (int)i.OdataCount;
        feladat.WorkingCount = (int)j.OdataCount;
    }
    private async void SelectedFeladat(object value)
    {
        @if (value is not null)
        {
            NetworkAccess accessType = Connectivity.Current.NetworkAccess;
            if (accessType != NetworkAccess.Internet)
            {
                await alert.ShowAlertAsync("Nincs internet, állítsa helyre a kapcsolatot!", "Internet hiba", "Rendben");
                return;
            }
            try
            {
                data.AssignmentId = value.ToString();
                submissions = await graph.GetFeladat(Id, data.AssignmentId);
                SelectedMembers.Clear();
                var feladatHianyok = await hiany.GetHianyokByFeladat(value.ToString());
                if(feladatHianyok is not null)
                {
                    feladatHianyok.ForEach(i => data.Members.FirstOrDefault(t => t.Id == i.TanuloId).IsHiany = i.Id);
                }
                foreach (var item in submissions.Value)
                {
                    var count = await graph.GetResourcesCount(Id, data.AssignmentId, item.Id);
                    var member = data.Members.Find(m => m.Id == Guid.Parse(item.SubmittedBy.User.Id));
                    if (member is null)
                    {
                        member = data.Members.Find(m => m.Id == data.StudentId) ?? new();
                    }
                    switch (item.Status)
                    {
                        case EducationSubmissionStatus.Working:
                            {
                                member.Status = (int)count.OdataCount > 0 ? "Beadva" : "Megtekintve";
                                member.SubmissionId = item.Id;
                                member.ResourceCount = (int)count.OdataCount;
                            }
                            break;
                        case EducationSubmissionStatus.Submitted:
                            {
                                //var member = data.Members.Find(m => m.Id == Guid.Parse(item.SubmittedBy.User.Id));
                                member.Status = "Beadva";
                                member.SubmissionId = item.Id;
                                member.ResourceCount = (int)count.OdataCount;
                            }
                            break;
                        case EducationSubmissionStatus.Released:
                            {
                                //var member = data.Members.Find(m => m.Id == Guid.Parse(item.SubmittedBy.User.Id));
                                member.Status = "Újra_released";
                                member.SubmissionId = item.Id;
                                member.ResourceCount = (int)count.OdataCount;
                            }
                            break;
                        case EducationSubmissionStatus.Returned:
                            {
                                //var member = data.Members.Find(m => m.Id == Guid.Parse(item.SubmittedBy.User.Id));
                                member.Status = "Visszaküldve";
                                member.SubmissionId = item.Id;
                                member.ResourceCount = (int)count.OdataCount;
                            }
                            break;
                        case EducationSubmissionStatus.UnknownFutureValue:
                            {
                                //var member = data.Members.Find(m => m.Id == Guid.Parse(item.SubmittedBy.User.Id));
                                member.Status = "Ismeretlen";
                                member.SubmissionId = item.Id;
                                member.ResourceCount = (int)count.OdataCount;
                            }
                            break;
                        case EducationSubmissionStatus.Reassigned:
                            {
                                //var member = data.Members.Find(m => m.Id == Guid.Parse(item.SubmittedBy.User.Id));
                                member.Status = "Újra";
                                member.SubmissionId = item.Id;
                                member.ResourceCount = (int)count.OdataCount;
                            }
                            break;
                        case EducationSubmissionStatus.Excused:
                            {
                                //var member = data.Members.Find(m => m.Id == Guid.Parse(item.SubmittedBy.User.Id));
                                member.Status = "Felmentve";
                                member.SubmissionId = item.Id;
                                member.ResourceCount = (int)count.OdataCount;
                            }
                            break;
                        default:
                            break;
                    }
                }
                data.Members = data.Members.OrderBy(m => m.Status).ToList();
                if (i > 0)
                {
                    data.Members.ForEach(delegate (MemberData m) { m.Selected = false; });
                    i = 0;
                }
                disableNone = false;
                disableSubmitted = false;
                disableWorking = false;
                StateHasChanged();
            }
            catch (Exception e)
            {
                await alert.ShowAlertAsync(e.Message, "Kivétel történt", "Ok");
            }
        }
    }
    private void SelectedFeladatEll(MemberData item)
    {
        try
        {
            data.SubmissionId = item.SubmissionId;
            data.Name = item.Name;
            data.StudentId = item.Id;
            data.IsHiany = item.IsHiany;
            navi.NavigateTo("ell");
        }
        catch (Exception e)
        {
            alert.ShowAlertAsync(e.Message, "Kivétel történt", "Ok");
        }
    }
    private void ItemSelectChange(MemberData item)
    {
        if (item.Selected)
        {
            item.Selected = false;
            SelectedMembers.Remove(item);
            i--;
        }
        else
        {
            item.Selected = true;
            SelectedMembers.Add(item);
            i++;
        }
    }
    private void Back()
    {
        data.Feladatok.Clear();
        data.Members.Clear();
        navi.NavigateTo("/");
    }
    private void Valtozas(bool changePont, ChangeEventArgs args)
    {
        changed = true;
        IsNotSaved = true;
        if (changePont)
        {
            //changedPont = true;
            if (float.TryParse(args.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var ujPont))
            {
                Pont = ujPont;
            }
        }
        else
        {
            //changedValasz = true;
            Valasz = args.Value?.ToString() ?? string.Empty;
        }
    }
    private void Valtozas(bool changePont, string args)
    {
        changed = true;
        IsNotSaved = true;
        if (changePont)
        {
            //changedPont = true;
            Pont = float.Parse(args);
        }
        else
        {
            //changedValasz = true;
            Valasz = args;
        }
    }
    private async Task Save()
    {
        NetworkAccess accessType = Connectivity.Current.NetworkAccess;
        if (accessType != NetworkAccess.Internet)
        {
            await alert.ShowAlertAsync("Nincs internet, állítsa helyre a kapcsolatot!", "Internet hiba", "Rendben");
            return;
        }
        var response = false;
        saveError.Clear();
        foreach (var item in SelectedMembers)
        {
            isError = false; // minden tanulónál újra kell kezdeni, különben az első hiba után mindenki hibásnak számít
            feladatValaszok = await graph.GetFeladatValasz(data.ClassId, data.AssignmentId, item.SubmissionId);
            foreach (var v in feladatValaszok.Value)
            {
                valasz = (EducationFeedbackOutcome)v;
                var Valasz_2 = (valasz is not null && valasz.Feedback is not null) ? valasz.Feedback.Text.Content : "Kedves " + NevHelper.KeresztNev(item.Name) + " " + Valasz;

                response = await graph.UpdateValasz(data.ClassId, data.AssignmentId, item.SubmissionId, valasz.Id, Valasz_2);
                if (!response)
                {
                    await alert.ShowAlertAsync($"A válasz mentése {item.Name} tanulónál nem sikerült!", "Hiba!", "Rendben");
                    isError = true;
                    break;
                }
                var mainResponse = await hiany.Add(new() { TanuloId = item.Id, FeladatId = Guid.Parse(data.AssignmentId), Datum = datumHiany, Osztaly = data.Osztalynev });
                if (!mainResponse.IsSuccess)
                {
                    await alert.ShowAlertAsync($"A hiány mentése {item.Name} tanulónál nem sikerült!", "Hiba!", "Rendben");
                    isError = true;
                    break;
                }
            }
            var feladatPontok = await graph.GetFeladatPont(data.ClassId, data.AssignmentId, item.SubmissionId);
            foreach (var p in feladatPontok.Value)
            {
                pont = (EducationPointsOutcome)p;
                @if (pont is not null && pont.Points is not null)
                {
                    Pont = pont.Points.Points.Value;
                    break;
                }
                response = await graph.UpdatePont(data.ClassId, data.AssignmentId, item.SubmissionId, pont.Id, Pont);
                if (!response)
                {
                    await alert.ShowAlertAsync($"A pont mentése {item.Name} tanulónál nem sikerült!", "Hiba!", "Rendben");
                    isError = true;
                    break;
                }
            }
            if (isError)
            {
                saveError.Add(item);
                continue;
            }
            else
            {
                await graph.Return(data.ClassId, data.AssignmentId, item.SubmissionId);
                var m = data.Members.First(m => m.Id == item.Id);
                m.Selected = false;
                m.Status = "Visszaküldve";
                i--;
                StateHasChanged();
            }
        }
        SelectedMembers.Clear();
        if (saveError.Count > 0)
        {
            SelectedMembers = saveError.ToList();
        }
        changed = false;
        IsNotSaved = true;
        await UpdateCount(data.AssignmentId);
    }
    private async Task Exused()
    {
        NetworkAccess accessType = Connectivity.Current.NetworkAccess;
        if (accessType != NetworkAccess.Internet)
        {
            await alert.ShowAlertAsync("Nincs internet, állítsa helyre a kapcsolatot!", "Internet hiba", "Rendben");
            return;
        }
        //var response = false;
        saveError.Clear();
        foreach (var item in SelectedMembers)
        {
            var resp = await graph.Excused(data.ClassId, data.AssignmentId, item.SubmissionId);
            if (!resp)
            {
                await alert.ShowAlertAsync("Nem sikerült a mentés! Próbálja újra!", "Mentési hiba", "Rendben");
                return;
            }
            var m = data.Members.First(m => m.Id == item.Id);
            m.Selected = false;
            m.Status = "Visszaküldve";
            i--;
            StateHasChanged();
        }
    }
    private void Select(string mode)
    {
        switch (mode)
        {
            case "Working":
                {
                    data.Members.Where(m => m.Status == "Megtekintve").ToList().ForEach(delegate (MemberData m)
                    {
                        m.Selected = true;
                        SelectedMembers.Add(m);
                        i++;
                    });
                    Valasz = "nem töltötted fel a házi feladatról a képet !?";
                    //changedValasz = true;
                    Pont = 0;
                    //changedPont = true;
                    changed = true;
                    disableWorking = true;
                    ChangeHiany();
                }
                break;
            case "Submitted":
                {
                    data.Members.Where(m => m.Status == "Beadva").ToList().ForEach(delegate (MemberData m)
                    {
                        m.Selected = true;
                        SelectedMembers.Add(m);
                        i++;
                    });
                    Valasz = "rendben ✔️";
                    //changedValasz = true;
                    // A Teams-feladat maximális pontszáma, ennek hiányában 2.
                    Pont = FeladatHelper.AlapPont(data.Feladatok.Find(f => f.Feladat.Id == data.AssignmentId)?.Feladat);
                    //changedPont = true;
                    changed = true;
                    disableSubmitted = true;
                }
                break;
            default:
                disableNone = true;
                break;
        }
        StateHasChanged();
    }
    private void AddText(string text)
    {
        Valasz = Valasz + $" {text}";
        changed = true;
        //changedValasz = true;
    }
    void ManageSzovegOpen()
    {
        navi.NavigateTo($"szoveg/feladatok");
    }
    void AddNewText()
    {
        visibleNewText = false;
    }
    void SaveText()
    {
        visibleNewText = true;
    }
    void ChangeHiany()
    {
        isHiany = isHiany ? false : true;
        changed = isHiany;
    }

}
