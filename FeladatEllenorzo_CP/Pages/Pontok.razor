@page "/pontok/{id}"
@inject IPontService pService
@inject GlobalData data
@inject NavigationManager nav
@inject IDialogService DialogService
@inject IToastService toastService
<FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Stretch">
    <h3>@osztaly csoport pontjai</h3>
    <FluentButton OnClick="@(()=> { data.Osztalynev = string.Empty; nav.NavigateTo("/"); })">Vissza</FluentButton>
</FluentStack>
@if (tanulok.Count == 0)
{
    <p>Nincsenek pontok.</p>
}
else
{
    //if (pontok.Count > 0) { magas = "50%"; }
     <FluentGrid>
        <FluentGridItem xs="12" sm="6">
            <FluentDataGrid TGridItem="Tanulo" Items="@tanulok.OrderBy(t => t.Name).AsQueryable()" Style="width: 100%;" AutoFit="true">
                <PropertyColumn Property="@(p => p.Name)" Sortable="true" />
                <PropertyColumn Property="@(p => p.Pont)" Sortable="true" />
                <TemplateColumn>
                                <FluentButton OnClick="@(()=>{pontok=context.Pontok??new();selectedTanulo=context.Id;})" IconStart="@(new Icons.Regular.Size20.SearchInfo())"/>
                                <FluentButton OnClick="@(()=>Pont_100(context))" Disabled="@(context.Pont <= 100)">100</FluentButton>
                                <FluentButton OnClick="@(()=>Pont_50(context))" Disabled="@(context.Pont <= 50)">50</FluentButton>
                </TemplateColumn>
            </FluentDataGrid>
        </FluentGridItem>
        <FluentGridItem xs="12" sm="6">
            @if (pontok.Count > 0)
            {
                <FluentDataGrid TGridItem="Pont" Items="@pontok.AsQueryable()" Style="width: 100%;" AutoFit="true">
                    <PropertyColumn Property="@(p => p.Datum)" Format="yyyy-MM-dd" Sortable="true" />
                    <PropertyColumn Property="@(p => p.PontTipus)" Sortable="true" />
                    <PropertyColumn Property="@(p => p.PontSzam)" Sortable="true" />
                    <PropertyColumn Property="@(p => p.Jegyzet)" />
                    <TemplateColumn>
                        <FluentButton OnClick="@(() => Update(context))" IconStart="@(new Icons.Regular.Size20.ClipboardEdit())" />
                        <FluentButton OnClick="@(() => Delete(context.Id))" IconStart="@(new Icons.Regular.Size20.Delete())")" />
                    </TemplateColumn>
                </FluentDataGrid>
             }
        </FluentGridItem>
    </FluentGrid> 
}

@code {
    [Parameter] public string Id { get; set; }
    private List<Tanulo> tanulok = new();
    private List<Pont> pontok = new();
    string osztaly = string.Empty;
    Guid selectedTanulo = Guid.Empty;
    protected override async Task OnInitializedAsync()
    {
        osztaly = data.Osztalynev;
        tanulok = await pService.GetPontByOsztaly(Id);
    }
    private async Task Pont_50(Tanulo tanulo)
    {
        await pService.Add(new Pont
        {
            Datum = DateTime.Now,
            PontTipus = PontTipus._50,
            PontSzam = -50,
            Jegyzet = "50% 5-ös",
            TanuloId = tanulo.Id,
        });
        tanulok = await pService.GetPontByOsztaly(Id);
        StateHasChanged();
    }
    private async Task Pont_100(Tanulo tanulo)
    {
        await pService.Add(new Pont
        {
            Datum = DateTime.Now,
            PontTipus = PontTipus._100,
            PontSzam = -100,
            Jegyzet = "100% 5-ös",
            TanuloId = tanulo.Id,
        });
        tanulok = await pService.GetPontByOsztaly(Id);
        StateHasChanged();
    }
    private async Task Update(Pont pont)
    {
        var dialog = await DialogService.ShowDialogAsync<EditPontDialog>(pont, new DialogParameters()
            {
                Title = $"{pont.PontTipus} típusú pont szerkesztése",
                PreventDismissOnOverlayClick = true,
                PreventScroll = true,
            });

        var result = await dialog.Result;
        if (!result.Cancelled && result.Data != null)
        {
            var updatedPont = (Pont)result.Data;
            var response = await pService.Update(updatedPont);
            if (response != null)
            {
                pont = response;
                toastService.ShowInfo("Pont frissítve.");
                tanulok = await pService.GetPontByOsztaly(Id);
            }
            else
            {
                toastService.ShowError($"Hiba a pont frissítése során: {pService.ErrorMessage}");
            }
        }
   }
    private async Task Delete(int id)
    {
        if (await pService.Remove(id))
        {
            toastService.ShowInfo("Pont törölve.");
            tanulok = await pService.GetPontByOsztaly(Id);
            pontok = pontok.Where(p => p.TanuloId == selectedTanulo).ToList();
            StateHasChanged();
        }
        else
        {
            toastService.ShowError($"Hiba a pont törlése során: {pService.ErrorMessage}");
        }
    }
}