@page "/szoveg"
@page "/szoveg/{url}"
@using System.Text.Json;
@using FeladatEllenorzo_CP.Services
@using FeladatLibrary.Data
@using Microsoft.FluentUI.AspNetCore.Components
@inject ISzovegService szovegService
@inject IAlertService alert

<PageHeader Title="Szövegsablonok" Subtitle="A visszajelzésekhez gyorsan beszúrható szövegek" OnBack="Close">
    <Actions>
        <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size20.Add())" OnClick="@(() => Edit(new() { Text = string.Empty, Type = "poz" }))">Új sablon</FluentButton>
    </Actions>
</PageHeader>

@if (!EditHiden)
{
    <div class="fe-card" style="max-width:640px">
        <h2 class="fe-card__title">@(string.IsNullOrEmpty(editedSzoveg.Text) ? "Új sablon" : "Sablon szerkesztése")</h2>
        <FeladatEllenorzo_CP.Components.NewSzoveg szoveg="editedSzoveg" SaveText="EditingEnd"></FeladatEllenorzo_CP.Components.NewSzoveg>
    </div>
}

@if (data.Szovegek.Count == 0)
{
    <p class="fe-muted">Még nincs szövegsablon.</p>
}
else
{
    <div class="fe-table-wrap">
        <table class="fe-table">
            <thead>
                <tr>
                    <th>Típus</th>
                    <th>Szöveg</th>
                    <th class="fe-table__actions">Művelet</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in data.Szovegek.OrderBy(s => s.Type == "poz" ? 0 : 1))
                {
                    <tr>
                        <td>
                            <span class="status @(item.Type == "poz" ? "status-visszakuldve" : "status-megtekintve")">@(item.Type == "poz" ? "pozitív" : "negatív")</span>
                        </td>
                        <td>@item.Text</td>
                        <td class="fe-table__actions">
                            <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size20.Edit())" OnClick="@(() => Edit(item))">Szerkesztés</FluentButton>
                            <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size20.Delete())" OnClick="@(() => Delete(item))">Törlés</FluentButton>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter] public string Url { get; set; } = "/";
    string path = Path.Combine(FileSystem.Current.AppDataDirectory, "szoveg.json");
    bool EditHiden = true;
    DataSzoveg editedSzoveg = new() { Text = string.Empty, Type = "poz" };

    void Edit(DataSzoveg szoveg)
    {
        EditHiden = false;
        editedSzoveg = szoveg;
    }

    void EditingEnd()
    {
        EditHiden = true;
    }

    async Task Delete(DataSzoveg szoveg)
    {
        if (!await alert.DisplayConfirm("Sablon törlése", $"Biztosan törli ezt a sablont?\n\n{szoveg.Text}", "Törlés", "Mégsem")) return;
        var response = await szovegService.Remove(szoveg);
        if (response.IsSuccess)
        {
            data.Szovegek.Remove(szoveg);
            SaveLocal();
            await notificationService.ShowInfoToastAsync("A sablon törölve.");
        }
        else
        {
            await alert.ShowAlertAsync(response.ErrorMessage, "Rendszer üzenet", "Rendben");
        }
    }

    /// <summary>A sablonok helyi másolata (offline használathoz).</summary>
    void SaveLocal()
    {
        var text = JsonSerializer.Serialize(data.Szovegek);
        using (StreamWriter sw = new StreamWriter(path))
        {
            sw.WriteLine(text);
        }
    }

    void Close()
    {
        var cel = string.IsNullOrEmpty(Url) ? "/" : Url;
        if (cel.Equals("feladatok"))
        {
            cel = cel + $"/{data.ClassId}";
        }
        navi.NavigateTo(cel);
    }
}
