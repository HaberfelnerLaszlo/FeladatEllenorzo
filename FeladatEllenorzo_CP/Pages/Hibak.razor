@page "/hiba"
@using FeladatEllenorzo_CP.Services
@using FeladatLibrary.Data
@inject GlobalData data
@inject IHibaService hiba
@inject IAlertService alert
@inject IGraphService graph
@inject ICsoportService csoportService

<PageHeader Title="Hibás feladatok" Subtitle="@datum.ToString("yyyy. MM. dd.")" BackHref="/">
    <Actions>
        <input type="date" class="fe-input fe-select--auto" aria-label="Dátum"
               value="@datum.ToString("yyyy-MM-dd")" @onchange="ChangeDatum" />
        <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size20.Send())" OnClick="Send" Disabled="@(LathatoTanulok.Count == 0)">Küldés magamnak</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size20.DeleteDismiss())" Title="Az összes rögzített hiba törlése, minden napról" OnClick="DeleteAll">Minden törlése</FluentButton>
    </Actions>
</PageHeader>

@if (LathatoTanulok.Count == 0)
{
    <p class="fe-muted">@message</p>
}
else
{
    <div class="fe-table-wrap">
        <table class="fe-table">
            <thead>
                <tr>
                    <th>Név</th>
                    <th>Hiba leírása</th>
                    <th class="fe-table__actions">Művelet</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var osztaly in osztalyok)
                {
                    var tanulok = LathatoTanulok.Where(h => h.Osztaly == osztaly).ToList();
                    if (tanulok.Count == 0) continue;
                    <tr class="fe-table__group">
                        <td colspan="2">@CsoportNev(osztaly) <span class="fe-muted">(@tanulok.Count fő)</span></td>
                        <td class="fe-table__actions">
                            <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size20.Delete())" Title="Az osztály aznapi hibáinak törlése" OnClick="@(() => DeleteClass(osztaly))">Osztály törlése</FluentButton>
                        </td>
                    </tr>
                    @foreach (var item in tanulok)
                    {
                        @foreach (var h in item.Hibak)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@h.Leiras</td>
                                <td class="fe-table__actions">
                                    <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size20.Delete())" OnClick="(() => Delete(item, h))">Törlés</FluentButton>
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    List<Tanulo> hibak = new();
    string[] osztalyok = [];
    Dictionary<string, string> csoportNevek = new();
    string message = string.Empty;
    DateTime datum = DateTime.Today;

    /// <summary>Csak azok a tanulók, akiknek van hibája a kiválasztott napon.</summary>
    List<Tanulo> LathatoTanulok => hibak.Where(t => t.Hibak.Count > 0).ToList();

    protected async override Task OnInitializedAsync()
    {
        message = "Betöltés alatt...";
        await BetoltCsoportNevek();
        hibak = await hiba.GetMaiHibak();
        Frissit();
    }

    async Task BetoltCsoportNevek()
    {
        try
        {
            var csoportok = await csoportService.GetCsoportok() ?? [];
            csoportNevek = csoportok.GroupBy(c => c.Id.ToString()).ToDictionary(g => g.Key, g => g.First().Name);
        }
        catch (Exception)
        {
            // A csoportnév csak megjelenítés; ha nem érhető el, az azonosító látszik.
        }
    }

    string CsoportNev(string osztaly) => csoportNevek.TryGetValue(osztaly ?? string.Empty, out var nev) ? nev : osztaly;

    void Frissit()
    {
        osztalyok = LathatoTanulok.Select(h => h.Osztaly).Distinct().OrderBy(CsoportNev).ToArray();
        message = $"Nincs rögzített hibás feladat ({datum:yyyy. MM. dd.}).";
    }

    async Task Ujratolt()
    {
        message = "Betöltés alatt...";
        // Kultúrafüggetlen formátum az API felé.
        hibak = await hiba.GetHibak(datum.ToString("yyyy-MM-dd"));
        Frissit();
    }

    async Task ChangeDatum(ChangeEventArgs e)
    {
        if (!DateTime.TryParse(e.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var uj)) return;
        datum = uj;
        await Ujratolt();
    }

    async Task Delete(Tanulo tanulo, HibasFeladat item)
    {
        if (await alert.DisplayConfirm("Művelet megerősítése", $"Biztosan törli {tanulo.Name} hibáját?", "Igen", "Nem"))
        {
            var response = await hiba.Remove(item);
            if (response.IsSuccess)
            {
                await notificationService.ShowInfoToastAsync("A hiba törölve.");
                hibak.FirstOrDefault(t => t.Id == tanulo.Id)?.Hibak.Remove(item);
                Frissit();
            }
            else
            {
                await alert.ShowAlertAsync(response.ErrorMessage, "Hiba", "Rendben");
            }
        }
    }

    public async Task Send()
    {
        string szoveg = datum.ToLongDateString() + ": ";
        foreach (var item in LathatoTanulok)
        {
            szoveg = szoveg + item.Name + System.Environment.NewLine;
        }
        // await: a GetAwaiter().GetResult() a UI szálon blokkolt.
        var response = await graph.SendMe(szoveg);
        if (response)
        {
            await notificationService.ShowSuccessToastAsync("Az üzenet elküldve.");
        }
        else await notificationService.ShowErrorToastAsync("Az üzenet küldése sikertelen.");
    }

    async Task DeleteAll()
    {
        if (!await alert.DisplayConfirm("Minden hiba törlése", "Biztosan törli az ÖSSZES rögzített hibát, minden napról? Ez nem vonható vissza.", "Törlés", "Mégsem")) return;
        var response = await hiba.RemoveAll();
        if (response.IsSuccess)
        {
            await notificationService.ShowInfoToastAsync("Minden hiba törölve.");
            await Ujratolt();
        }
        else
        {
            await alert.ShowAlertAsync(response.ErrorMessage, "Rendszer üzenet", "Rendben");
        }
    }

    async Task DeleteClass(string osztaly)
    {
        if (!await alert.DisplayConfirm("Osztály hibáinak törlése", $"Biztosan törli a(z) {CsoportNev(osztaly)} {datum:yyyy. MM. dd.} napi hibáit?", "Törlés", "Mégsem")) return;
        var response = await hiba.RemoveClass(osztaly, datum.ToString("yyyy-MM-dd"));
        if (response.IsSuccess)
        {
            await notificationService.ShowInfoToastAsync("Az osztály hibái törölve.");
            await Ujratolt();
        }
        else
        {
            await alert.ShowAlertAsync(response.ErrorMessage, "Rendszer üzenet", "Rendben");
        }
    }
}
