@using Microsoft.Extensions.Configuration
@using Microsoft.AspNetCore.Hosting
@using Microsoft.Extensions.Hosting
@inject TeamsUserCredential teamsUserCredential
@inject IWebHostEnvironment HostEnvironment
@inject IConfiguration Configuration
@inject NavigationManager MyNavigationManager
@inject MathService mService

@if (isLoading)
{
    <div style="display: flex; justify-content: center; align-items: center; min-height: 100vh;">
        <FluentProgressRing />
    </div>
}
else
{
    <div class="welcome page">
        <div class="narrow page-padding">
            <p class="center">Your app is running in your @(GetEnvironmentName())</p>
            @if (lessons is null || lessons.Count == 0)
            {
                <Graph ErrorMessage="@errorMessage" />
            }
            else
            {
                <FluentTabs style="width: 80%; justify-content: space-between; margin: 4rem auto;">
                    <FluentTab style="font-size: 14px; min-height: 32px;">
                        <Header>Pontjaid</Header>
                        <Content>
                            <div style="display:block; min-width:max-content;">
                                <Graph ErrorMessage="@errorMessage" />
                            </div>
                        </Content>
                    </FluentTab>
                    <FluentTab>
                        <Header>Matek gyakorló</Header>
                        <Content>
                            <MathCourse StudentId="userId" />
                            <Deploy />
                        </Content>
                    </FluentTab>
                </FluentTabs>
            }

            @*<img src="hello.png" />
                <h1 class="center">Congratulations@(!String.IsNullOrEmpty(userName) ? ", " + userName : "")!</h1>
                    <!--
                    <FluentTab>
                        <Header>3. Publish to Teams</Header>
                        <Content>
                            <Publish />
                        </Content>
                    </FluentTab>
                </FluentTabs>*@
        </div>
    </div>
}

@code {
    string userName =string.Empty;
    string errorMessage =string.Empty;
    bool isLoading = true;
    Guid userId;
    List<Lesson> lessons = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        try
        {
            if (firstRender)
            {
                var user = await teamsUserCredential.GetUserInfoAsync();
                userName = user.DisplayName;
                userId = Guid.Parse(user.ObjectId);
                lessons = await mService.GetLessons(Guid.Parse(user.ObjectId));
            }
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private string GetEnvironmentName()
    {
        return HostEnvironment.IsDevelopment() ? "local environment" : "Azure environment";
    }
}